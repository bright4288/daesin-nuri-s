<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>2026년 대신&누리 워크샵</title>
<link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#e8efe9;--surface:#f7faf7;--ink:#1d2b2a;--sub:#53645f;--red:#b83a2b;--gold:#8f6a1f;--line:#c4d2c8;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#18221f;--surface:#212e2a;--ink:#e9f0ec;--sub:#a3b5ad;--red:#ef7766;--gold:#d9b462;--line:#35463f;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#18221f;--surface:#212e2a;--ink:#e9f0ec;--sub:#a3b5ad;--red:#ef7766;--gold:#d9b462;--line:#35463f;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Apple SD Gothic Neo","Noto Sans KR",sans-serif;line-height:1.6}
main{max-width:560px;margin:0 auto;padding:28px 18px 60px}
h1{font-family:"Gowun Batang",Georgia,serif;font-size:2rem;line-height:1.25;margin:0 0 4px;text-align:center}
.sub{color:var(--sub);margin:0 0 22px;text-align:center}
nav{display:flex;gap:8px;margin-bottom:20px}
nav button{flex:1;padding:12px;border:1.5px solid var(--line);background:transparent;color:var(--ink);border-radius:10px;font:inherit;font-weight:600;cursor:pointer}
nav button[aria-selected="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px}
label{display:block;font-weight:600;margin:0 0 6px}
select,input{width:100%;padding:13px;border:1.5px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font:inherit;margin-bottom:16px}
.go{width:100%;padding:14px;border:0;border-radius:10px;background:var(--red);color:#fff;font:inherit;font-weight:700;font-size:1.05rem;cursor:pointer}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.err{color:var(--red);font-weight:600;margin:12px 0 0;min-height:1.4em}
.result{margin-top:20px;padding-top:18px;border-top:2px solid var(--red)}
.result h2{font-family:"Gowun Batang",Georgia,serif;font-size:1.7rem;margin:0 0 6px}
.result .k{color:var(--sub);font-size:.9rem;margin:14px 0 2px}
.result .v{font-size:1.25rem;font-weight:700;margin:0}
.note{color:var(--sub);font-size:.9rem;margin-top:14px}
.big{font-family:"Gowun Batang",Georgia,serif;font-size:6.5rem;line-height:1;text-align:center;color:var(--red);margin:10px 0 18px;font-variant-numeric:tabular-nums}
.row{display:flex;gap:10px}
.row>div{flex:1}
.ghost{background:transparent;border:1.5px solid var(--line);color:var(--ink)}
ol{padding-left:0;list-style:none;margin:8px 0 0}
li{font-size:1.1rem;font-weight:600}
[hidden]{display:none!important}
</style>
</head>
<body>
<main>
<h1>2026년 대신&누리 워크샵</h1>
<p class="sub">미션 포즈 확인과 경품권 추첨</p>
<nav role="tablist">
<button role="tab" id="t-team" aria-selected="true">조 확인</button>
<button role="tab" id="t-pose" aria-selected="false">포즈 확인</button>
<button role="tab" id="t-draw" aria-selected="false">경품권 추첨</button>
</nav>

<section id="teamsec" class="card">
<label for="arr">이름</label>
<input id="arr" type="text" autocomplete="off" placeholder="본인 이름을 입력하세요">
<button class="go" id="tgo">우리 조 확인하기</button>
<p class="err" id="terr" role="alert"></p>
<div class="result" id="tres" hidden>
<h2 id="tname"></h2>
<p class="k">조원</p><p class="v" id="tmem" style="font-size:1.05rem"></p>
<p class="note">같은 조 팀원끼리 모여 주세요. 조 코드는 돌림판을 돌린 뒤 포즈 카드 뒷면에서 확인할 수 있어요.</p>
</div>
</section>

<section id="pose" class="card" hidden>
<label for="team">우리 조</label>
<select id="team"></select>
<label for="code">조 코드</label>
<input id="code" inputmode="numeric" autocomplete="off" placeholder="미션 카드에 적힌 4자리">
<label for="posesel">돌림판에서 나온 포즈</label>
<select id="posesel"></select>
<label for="placesel">돌림판에서 나온 장소</label>
<select id="placesel"></select>
<button class="go" id="check">포즈 확인하기</button>
<p class="err" id="err" role="alert"></p>
<div class="result" id="res" hidden>
<h2 id="rteam"></h2>
<p class="k">장소</p><p class="v" id="rplace"></p>
<p class="k">포즈</p><p class="v" id="rpose"></p>
<img id="rimg" alt="" style="display:none;width:100%;border-radius:12px;margin-top:14px">
<p class="note">포즈 뒤 QR로 인증 사진을 확인하세요.</p>
</div>
</section>

<section id="draw" class="card" hidden>
<div class="row">
<div><label for="max">추첨 번호 범위 (1~)</label><input id="max" type="number" value="60" min="1" max="60"></div>
<div><label for="ord">추첨 순서</label><select id="ord"><option value="down">24등 → 1등</option><option value="up">1등 → 24등</option></select></div>
</div>
<canvas id="cv" width="320" height="320" style="display:block;margin:0 auto 8px;max-width:100%;height:auto" aria-hidden="true"></canvas>
<div class="big" id="num" aria-live="polite" style="font-size:2.4rem;margin:4px 0 16px">?</div>
<button class="go" id="spin">추첨하기</button>
<p class="err" id="derr"></p>
<p class="k" style="margin:14px 0 0;color:var(--sub)">당첨 번호 (중복 없음)</p>
<ol id="wins"></ol>
<button class="go ghost" id="reset" style="margin-top:16px">처음부터 다시</button>
</section>
</main>

<script>
/* ▼ 여기만 수정하세요: 조별 장소 · 포즈 · 코드 (현재 임시 예시) ▼ */
var TEAMS=[
{name:"1조",code:"4821"},
{name:"2조",code:"7305"},
{name:"3조",code:"1964"},
{name:"4조",code:"5538"},
{name:"5조",code:"2087"},
{name:"6조",code:"9410"}
];
/* 돌림판 포즈 6개: 번호 순서대로 */
var POSES=[
{title:"출동응원단",img:"pose1.jpg",desc:"예시 포즈를 최대한 비슷하게 재현해 팀원 전원이 1장 촬영하세요."},
{title:"사랑의 꽃 피우기",img:"pose2.jpg",desc:"예시 포즈를 최대한 비슷하게 재현해 팀원 전원이 1장 촬영하세요."},
{title:"인간피라미드",img:"pose3.jpg",desc:"예시 포즈를 최대한 비슷하게 재현해 팀원 전원이 1장 촬영하세요."},
{title:"요염한 나 오때",img:"pose4.jpg",desc:"예시 포즈를 최대한 비슷하게 재현해 팀원 전원이 1장 촬영하세요."},
{title:"날아라 인간도미노",img:"pose5.jpg",desc:"예시 포즈를 최대한 비슷하게 재현해 팀원 전원이 1장 촬영하세요."},
{title:"우리 함께 빛나",img:"pose6.jpg",desc:"예시 포즈를 최대한 비슷하게 재현해 팀원 전원이 1장 촬영하세요."}
];
/* 돌림판 장소 3개: 번호 순서대로 */
var PLACES=[
{title:"첨성대 앞",desc:"이 장소에서 촬영하세요."},
{title:"교촌마을 한옥 돌담길",desc:"이 장소에서 촬영하세요."},
{title:"계림숲 산책로",desc:"이 장소에서 촬영하세요."}
];
/* ▲ 여기까지 ▲ */

var $=function(i){return document.getElementById(i)};
var sel=$("team");
TEAMS.forEach(function(t,i){var o=document.createElement("option");o.value=i;o.textContent=t.name;sel.appendChild(o)});
function fill(id,arr,label){var s=$(id);arr.forEach(function(x,i){var o=document.createElement("option");o.value=i;
o.textContent=(i+1)+". "+x.title;s.appendChild(o)})}

function show(which){
 ["teamsec","pose","draw"].forEach(function(id){var k=id==="teamsec"?"team":id;$(id).hidden=(k!==which);$("t-"+k).setAttribute("aria-selected",k===which)});
 try{history.replaceState(null,"","#"+which)}catch(e){}
}
$("t-team").onclick=function(){show("team")};
$("t-pose").onclick=function(){show("pose")};
$("t-draw").onclick=function(){show("draw")};
var hm=location.hash.match(/^#p([1-6])$/);
if(hm){show("pose");$("posesel").value=String(parseInt(hm[1],10)-1)}
else if(location.hash==="#draw")show("draw");else if(location.hash==="#pose")show("pose");

function check(){
 var t=TEAMS[sel.value];
 if($("code").value.trim()!==t.code){
  $("err").textContent="코드가 맞지 않아요. 미션 카드의 4자리를 다시 확인하세요.";
  $("res").hidden=true;return;
 }
 $("err").textContent="";
 $("rteam").textContent=t.name+" 미션";
 var pl=PLACES[$("placesel").value],po=POSES[$("posesel").value];
 $("rplace").textContent=pl.title+" — "+pl.desc;
 $("rpose").textContent=po.title+" — "+po.desc;
 var im=$("rimg");
 im.onerror=function(){im.style.display="none"};
 im.style.display="block";im.alt=po.title+" 예시 사진";im.src=po.img;
 $("res").hidden=false;
}
$("check").onclick=check;
$("code").addEventListener("keydown",function(e){if(e.key==="Enter")check()});

/* 조별 명단: 위에서부터 1조, 2조 ... 6조 순서 */
var MEMBERS=[
["성명찬","추근호","이성진","권혁준","김화섭","조선인","김상진","박기홍"],
["서정수","김종복","윤상근","이승준","김재훈","이광학","김현욱","구은진"],
["김경헌","임지웅","박정민","한상명","김중근","최창수","문성호"],
["이경기","설유승","장유성","황류현","아민혁","김도경","강유진"],
["손욱호","김태우","성현수","김재윤","김광규","곽승훈","윤일규"],
["조천기","한창욱","이일","전명중","한승주","최대웅","우슬기"]
];
function teamCheck(){
 var q=$("arr").value.replace(/\s/g,"");
 var ti=-1;MEMBERS.forEach(function(m,i){if(m.indexOf(q)>=0)ti=i});
 if(ti<0){$("terr").textContent="명단에 없는 이름이에요. 이름을 다시 확인하세요.";$("tres").hidden=true;return}
 $("terr").textContent="";
 $("tname").textContent=TEAMS[ti].name+"입니다";$("tmem").textContent=MEMBERS[ti].join(", ");
 $("tres").hidden=false;
}
$("tgo").onclick=teamCheck;
$("arr").addEventListener("keydown",function(e){if(e.key==="Enter")teamCheck()});

var won=[],ranks=[],TOTAL=24,busy=false;
function render(){
 var ol=$("wins");ol.innerHTML="";
 won.forEach(function(n,i){var li=document.createElement("li");li.textContent=ranks[i]+"등 · "+n+"번";ol.appendChild(li)});
}
var cv=$("cv"),cx=cv.getContext("2d"),W=320,C=160,R=148,dpr=window.devicePixelRatio||1;
cv.width=W*dpr;cv.height=W*dpr;cx.scale(dpr,dpr);
var balls=[],mode="idle",mixT=0,pickBall=null,pickT=0;
function build(){
 var max=Math.min(60,Math.max(1,parseInt($("max").value,10)||44));
 balls=[];
 for(var i=1;i<=max;i++){
  if(won.indexOf(i)>=0)continue;
  var a=Math.random()*6.28,d=Math.random()*(R-30);
  balls.push({n:i,x:C+Math.cos(a)*d,y:C+Math.sin(a)*d,vx:Math.random()*4-2,vy:Math.random()*4-2,r:12});
 }
}
function step(){
 var g=mode==="mix"?0.05:0.18,i,j;
 for(i=0;i<balls.length;i++){
  var b=balls[i];
  if(b===pickBall)continue;
  b.vy+=g;
  if(mode==="mix"){b.vy-=Math.random()*0.9*(b.y>C-20?1:0.2);b.vx+=Math.random()*1.2-0.6}
  var sp=Math.sqrt(b.vx*b.vx+b.vy*b.vy);
  if(sp>9){b.vx*=9/sp;b.vy*=9/sp}
  b.x+=b.vx;b.y+=b.vy;
  var dx=b.x-C,dy=b.y-C,d=Math.sqrt(dx*dx+dy*dy),lim=R-b.r;
  if(d>lim){var nx=dx/d,ny=dy/d,dot=b.vx*nx+b.vy*ny;b.vx=(b.vx-2*dot*nx)*0.92;b.vy=(b.vy-2*dot*ny)*0.92;b.x=C+nx*lim;b.y=C+ny*lim}
 }
 for(i=0;i<balls.length;i++)for(j=i+1;j<balls.length;j++){
  var p1=balls[i],p2=balls[j];
  if(p1===pickBall||p2===pickBall)continue;
  var ex=p2.x-p1.x,ey=p2.y-p1.y,e=Math.sqrt(ex*ex+ey*ey),m=p1.r+p2.r;
  if(e<m&&e>0.01){
   var ux=ex/e,uy=ey/e,ov=(m-e)/2;
   p1.x-=ux*ov;p1.y-=uy*ov;p2.x+=ux*ov;p2.y+=uy*ov;
   var q=(p1.vx-p2.vx)*ux+(p1.vy-p2.vy)*uy;
   p1.vx-=q*ux;p1.vy-=q*uy;p2.vx+=q*ux;p2.vy+=q*uy;
  }
 }
}
function ball(b){
 var h=(b.n*47)%360,gr=cx.createRadialGradient(b.x-b.r*0.35,b.y-b.r*0.35,b.r*0.1,b.x,b.y,b.r);
 gr.addColorStop(0,"hsl("+h+",85%,72%)");gr.addColorStop(1,"hsl("+h+",70%,42%)");
 cx.beginPath();cx.arc(b.x,b.y,b.r,0,6.2832);cx.fillStyle=gr;cx.fill();
 cx.fillStyle="#fff";cx.beginPath();cx.arc(b.x,b.y,b.r*0.58,0,6.2832);cx.fill();
 cx.fillStyle="#222";cx.font="700 "+Math.round(b.r*0.72)+"px system-ui,sans-serif";cx.textAlign="center";cx.textBaseline="middle";
 cx.fillText(b.n,b.x,b.y+1);
}
function paint(){
 var s=getComputedStyle(document.documentElement);
 cx.clearRect(0,0,W,W);
 cx.beginPath();cx.arc(C,C,R,0,6.2832);cx.fillStyle=s.getPropertyValue("--surface");cx.fill();
 cx.lineWidth=5;cx.strokeStyle=s.getPropertyValue("--line");cx.stroke();
 balls.forEach(function(b){if(b!==pickBall)ball(b)});
 if(pickBall)ball(pickBall);
}
function startPick(){
 var b=balls[Math.floor(Math.random()*balls.length)];
 b.sx=b.x;b.sy=b.y;b.done=false;pickBall=b;pickT=0;mode="pick";
}
function finish(){
 var rk=$("ord").value==="down"?TOTAL-won.length:won.length+1;
 won.push(pickBall.n);ranks.push(rk);$("ord").disabled=true;
 $("num").textContent=rk+"등 · "+pickBall.n+"번";
 render();busy=false;mode="idle";
}
function loop(){
 requestAnimationFrame(loop);
 if($("draw").hidden)return;
 if(mode==="mix"){mixT--;if(mixT<=0)startPick()}
 if(mode==="pick"){
  pickT++;
  var k=Math.min(1,pickT/50),e=1-Math.pow(1-k,3);
  pickBall.x=pickBall.sx+(C-pickBall.sx)*e;
  pickBall.y=pickBall.sy+(C-pickBall.sy)*e;
  pickBall.r=12+48*e;
  if(k>=1&&!pickBall.done){pickBall.done=true;finish()}
 }
 step();paint();
}
$("spin").onclick=function(){
 if(busy)return;
 var max=parseInt($("max").value,10);
 if(!(max>=1)){$("derr").textContent="번호 범위를 입력하세요.";return}
 if(max>60){$("derr").textContent="번호는 최대 60까지 가능해요.";return}
 if(won.length>=TOTAL){$("derr").textContent="24등까지 모두 추첨되었어요.";return}
 pickBall=null;build();
 if(!balls.length){$("derr").textContent="모든 번호가 추첨되었어요.";return}
 $("derr").textContent="";$("num").textContent=($("ord").value==="down"?TOTAL-won.length:won.length+1)+"등 추첨 중…";
 busy=true;mode="mix";mixT=170;
};
$("reset").onclick=function(){if(busy)return;won=[];ranks=[];$("ord").disabled=false;pickBall=null;render();$("num").textContent="?";$("derr").textContent="";build()};
$("max").onchange=function(){if(!busy){pickBall=null;build()}};
build();requestAnimationFrame(loop);
</script>
</body>
</html>
